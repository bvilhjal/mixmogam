+def target_variant_mask(chromosome, qc_keep, target_m):
+    """Keep the first passing variants in six fixed, nearly equal quotas.
+
+    Quotas are multiples of the generator's 50-marker LD-block size; extra
+    blocks go to the first chromosomes. Selection uses genotype QC only,
+    before PCs, QTL sampling or phenotype generation. Candidate indices and
+    physical positions remain unchanged when a preceding marker is removed.
+    """
+    if (isinstance(target_m, (bool, np.bool_)) or not isinstance(target_m, (int, np.integer))
+            or target_m < 600 or target_m % 50):
+        raise ValueError("target_m must be an integer >=600 divisible by 50")
+    chromosome, qc_keep = np.asarray(chromosome), np.asarray(qc_keep, dtype=bool)
+    if chromosome.ndim != 1 or qc_keep.shape != chromosome.shape:
+        raise ValueError("chromosome and QC mask must be matching one-dimensional arrays")
+    blocks, remainder = divmod(int(target_m) // 50, 6)
+    quotas = 50 * (blocks + (np.arange(6) < remainder))
+    selected = np.zeros(qc_keep.size, dtype=bool)
+    for chrom, quota in enumerate(quotas, 1):
+        passing = np.flatnonzero(qc_keep & (chromosome == chrom))
+        if passing.size < quota:
+            raise ValueError(f"chromosome {chrom} has {passing.size} variants passing MAF QC; "
+                             f"target_m={target_m} requires {quota}; no panel was selected")
+        selected[passing[:quota]] = True
+    return selected, quotas
+
+
